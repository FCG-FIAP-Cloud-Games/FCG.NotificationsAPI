RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
NOTIFICATIONS_API_TAG=1.0.1

# SMTP de um provedor que entregue mensagens para caixas reais.
# SMTP_FROM deve ser um remetente/domínio autorizado nesse provedor.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASSWORD=configure-sua-senha-ou-app-password
SMTP_FROM=no-reply@seudominio.com
SMTP_SECURE_SOCKET_OPTIONS=StartTls

# Destinatário de teste da confirmação de pagamento, apenas em Development.
NOTIFICATIONS_TEST_RECIPIENT=leoloss@uorak.com
