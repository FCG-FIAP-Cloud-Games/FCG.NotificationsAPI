NOTIFICATIONS_API_TAG=1.0.7
FCG_USERS_HTTP_PORT=5088
FCG_CATALOG_HTTP_PORT=5081
FCG_PAYMENTS_HTTP_PORT=5082
FCG_NOTIFICATIONS_HTTP_PORT=5083
FCG_RABBIT_MANAGEMENT_PORT=15672
# Para compartilhar o painel apenas em uma rede local confiável, use 0.0.0.0.
FCG_RABBIT_MANAGEMENT_BIND_ADDRESS=127.0.0.1

# Credenciais locais de demonstração do compose integrado. São valores de teste,
# independentes do .env usado pela stack standalone de Notifications.
FCG_DEMO_RABBITMQ_USER=fcg_demo
FCG_DEMO_RABBITMQ_PASSWORD=Rabbit_Demo_2026!
FCG_DEMO_POSTGRES_USER=fcg_users_demo
FCG_DEMO_POSTGRES_PASSWORD=UsersDb_Demo_2026!

# Destino padrão para testes locais com MailHog.
SMTP_HOST=smtp-dev
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fcgnotifications.local
SMTP_SECURE_SOCKET_OPTIONS=None
# Para envio externo, substitua os valores acima pelos dados do seu provedor SMTP.

# Modo persistente do Notifications (Inbox + idempotência). Use true para validar o C37.
NOTIFICATIONS_DISPATCHER_ENABLED=false
# Id estável do destino SMTP (obrigatório com o modo persistente ligado).
SMTP_DESTINATION_ID=smtp-dev

# Exchanges de origem dos eventos publicados por Users e Payments (confirme em Exchanges
# no RabbitMQ Management). O rabbitmq-bindings liga cada um ao exchange do Notifications.
USERS_USER_CREATED_EXCHANGE=FCG.Notifications.Application.Messaging.Contracts:UserCreatedEvent
PAYMENTS_PAYMENT_PROCESSED_EXCHANGE=PaymentProcessedEvent