RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
NOTIFICATIONS_API_TAG=1.0.4
FCG_RABBIT_MANAGEMENT_PORT=15672
# Para compartilhar o painel apenas em uma rede local confiável, use 0.0.0.0.
FCG_RABBIT_MANAGEMENT_BIND_ADDRESS=127.0.0.1

# Valores usados somente com docker-compose.smtp-real.yml.
# O Compose padrão sempre usa MailHog, mesmo que estas variáveis estejam preenchidas.
# Para entrega externa, substitua pelos dados reais do provedor e use um remetente autorizado.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASSWORD=configure-sua-senha-ou-app-password
SMTP_FROM=no-reply@seudominio.com
SMTP_SECURE_SOCKET_OPTIONS=StartTls
